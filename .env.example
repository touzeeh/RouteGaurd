# Copy this file to .env and supply credentials from your Gemma hosting provider.
PORT=8000
FRONTEND_ORIGIN=http://localhost:5175
# Google Gemini API native generateContent endpoint is used by the server.
GEMMA_API_KEY=replace-with-your-provider-key
GEMMA_MODEL=gemma-4-26b-a4b-it

# Browser URL for the local API proxy. Keep this value public and key-free.
VITE_GEMMA_API_URL=http://localhost:8000/api/gemma/briefing

VITE_ROUTE_API_BASE_URL=http://localhost:8000/api
